# Supabase (se configura en Fase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca exponer al cliente ni prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Proveedores de IA. Solo servidor.
GEMINI_API_KEY=
GROQ_API_KEY=
# Cuál probar primero: "gemini" (default) o "groq". El otro configurado
# actúa como fallback automático si el principal falla.
AI_PROVIDER=gemini
# Opcionales — override del modelo por defecto de cada proveedor
# (lib/ai/gemini.ts, lib/ai/groq.ts). Útil si el proveedor retira el
# modelo por defecto.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b

# Correos (coma-separados) que ven /admin/pagos y pueden aprobar/rechazar
# comprobantes de Yape. No hay rol "admin" en la base de datos a propósito
# (ver lib/config/admin.ts) — comparación server-side únicamente.
ADMIN_EMAILS=

# Límites de uso gratuito (opcionales — ver defaults en lib/config/limits.ts)
MAX_AI_REQUESTS_PER_DAY=20
MAX_DOCUMENTS_PER_DAY=10
MAX_FILE_SIZE_MB=10

# REQUERIDA en despliegues multi-instancia (Vercel, cualquier serverless).
# Next.js encripta los valores que un Server Action captura vía closure/
# .bind() (usado por setRole() y sendChatMessage()) para viajar seguros
# entre cliente y servidor. Sin esta variable, cada instancia genera su
# propia clave al azar: si la petición que renderiza la página la maneja
# una instancia y el submit del formulario la maneja otra, no logran
# descifrarse entre sí y el Server Action falla en silencio (síntoma:
# onboarding en loop, cambio de rol en Configuración sin efecto, chat
# con documentos sin responder — todos usan .bind()). No hace falta en
# desarrollo local (un solo proceso). Generar con: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
